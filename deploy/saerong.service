[Unit]
Description=saerong.com FastAPI (uvicorn)
After=network.target postgresql.service

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/srv/course-repo
Environment=PYTHONUNBUFFERED=1

# TDM 모델은 워커별로 로드되므로 메모리 사용량을 확인한 뒤 워커 수를 조정한다.
ExecStart=/srv/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --proxy-headers \
    --forwarded-allow-ips='127.0.0.1' \
    --timeout-keep-alive 65

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
