[Unit]
Description=saerong.com FastAPI (uvicorn)
After=network.target postgresql.service

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/srv/course-repo
Environment=PYTHONUNBUFFERED=1

# 워커 1개 — 이유:
#  1) TDM 모델(sklearn + torch)이 워커마다 약 470MB 를 잡는다.
#  2) 채팅 WebSocket 브로드캐스트가 프로세스 안에서 이뤄지므로 여러 워커면
#     서로 다른 워커에 붙은 클라이언트에게 메시지가 전달되지 않는다.
# I/O 대기는 async 가 처리하고, CPU 바운드인 추론만 threadpool 로 넘긴다.
ExecStart=/srv/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --proxy-headers \
    --forwarded-allow-ips='127.0.0.1' \
    --timeout-keep-alive 65

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
