# Copy this file to .env for isolated local development.
# Do not use these settings on a public server.
DEBUG=true
SECRET_KEY=local-development-only-change-before-deployment
DATABASE_URL=postgresql://test:test@127.0.0.1:1/unused
TDM_AUTH_USER=local-preview
TDM_AUTH_PASSWORD=local-preview-only
SITE_ORIGIN=http://127.0.0.1:8000

# Optional. Never commit actual credentials.
AI_HUB_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
INQUIRY_TO=

# Production admin uses a dedicated PBKDF2 hash. Leave empty for local mode.
SITE_ADMIN_USER=
SITE_ADMIN_PASSWORD_HASH=
